# Nebius Token Factory (get a key in the Token Factory console).
# If the key is injected as a network secret instead, leave it empty and set HP_LIVE=1.
NEBIUS_API_KEY=
HP_LIVE=0
# Verify the base URL and model IDs with: python scripts/check_models.py
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/
NEMOTRON_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEMOTRON_SUPER=nvidia/nemotron-3-super-120b-a12b
NEMOTRON_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b
# Set MOCK=1 to run without calling any model
MOCK=0
# Optional LangSmith tracing (APAC region shown)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
LANGSMITH_PROJECT=heritage-plate
LANGSMITH_API_KEY=
